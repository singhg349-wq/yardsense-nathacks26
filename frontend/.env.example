# Copy to .env to point the frontend at a different backend.
VITE_API_URL=http://localhost:8000
# Optional: free key for the CARTO dark map tiles (https://carto.com/basemaps/apikey).
# Without one, the Map tab uses darkened OpenStreetMap tiles.
# DO NOT PUT ONE IN THIS FILE. MAKE A .env FILE LOCALLY AND PUT YOUR KEY IN THERE.
# cp .env.example .env
# VITE_CARTO_KEY=your-carto-key-here
